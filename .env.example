# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (supabase.com → seu projeto → Project Settings → API Keys). O .env.local NUNCA vai pro GitHub.
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (começa com sb_publishable_). Pode aparecer no navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (começa com sb_secret_). SÓ no servidor: nunca coloque NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=
# ID do cliente OAuth do Google (termina em .apps.googleusercontent.com). Não é secreto.
# Com ele, a tela do Google mostra o nome do app em vez do endereço do Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
